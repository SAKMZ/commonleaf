# ─────────────────────────────────────────────────────────────────────────────
# Storage
#
# Commonleaf keeps every note as a Markdown file in a Git repository. Choose one
# driver. All of these values are read on the server only; none of them are
# exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# "github" (default) or "filesystem".
STORAGE_DRIVER=github

# ── GitHub driver ────────────────────────────────────────────────────────────
# A fine-grained personal access token scoped to the single repository that
# holds your notes, with "Contents: read and write". Nothing else is required.
# Create one at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# The account or organisation that owns the repository.
GITHUB_OWNER=your-username

# The repository name on its own, without the owner prefix.
GITHUB_REPOSITORY=commonplace

# The branch to read from and commit to.
GITHUB_BRANCH=main

# Override for GitHub Enterprise Server installations.
# GITHUB_API_BASE_URL=https://github.example.com/api/v3

# ── Filesystem driver ────────────────────────────────────────────────────────
# Absolute path to a directory holding the vault. If that directory is a Git
# working tree, Commonleaf commits after every change and version history works
# exactly as it does with the GitHub driver.
# CONTENT_ROOT=/data/vault

# ── Shared ───────────────────────────────────────────────────────────────────
# Directory inside the repository that holds notes. Everything outside it is
# left alone, so the repository can also contain a README, a site, or anything
# else you like.
CONTENT_DIRECTORY=content
